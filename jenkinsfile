pipeline {
    agent any

    stages {
        stage('Clone') {
            steps {
                // Clone the repository from GitHub
                git branch: 'main', url: 'https://github.com/suhas1995/java11-examples.git'
            }
        }

        stage('Build') {
            steps {
                script {
                    sh 'docker build -t localhost:5000/python-demo:v1 .'
                }
            }
        }

        stage('Push') {
            steps {
                script {
                    sh 'docker push localhost:5000/python-demo:v1'
                }
            }
        }
    }
}

